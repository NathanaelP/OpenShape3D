# ──────────────────────────────────────────────
# OpenShape — .gitignore
# Qt 6 + OpenCASCADE (OCCT) + CMake, C++
# Commit YOUR source only. Never commit deps or build output.
# ──────────────────────────────────────────────

# ---- Build output (regenerated by CMake — never commit) ----
build/
build-*/
out/
cmake-build-*/        # CLion default build dirs
_deps/                # CMake FetchContent / vcpkg-fetched deps
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json # local, user-specific presets
install/
*.cmake.stamp

# ---- Compiled / linked artifacts ----
*.o
*.obj
*.lo
*.slo
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.out
*.app/
*.pdb
*.ilk
*.exp
*.gch
*.pch

# ---- Dependencies (referenced, NOT stored in the repo) ----
# Qt and OCCT are installed via vcpkg/Conan or system packages — see CLAUDE.md.
vcpkg_installed/
.conan/
conan.lock
conanbuildinfo.*
conaninfo.txt
graph_info.json
third_party/**/build/

# ---- Release binaries (use GitHub Releases, not the repo) ----
release/
dist/
packages/
*.dmg
*.AppImage
*.msi
*.zip
*.tar.gz

# ---- Large test models (prefer Git LFS for big CAD files) ----
# Keep committed test fixtures SMALL. Route chunky models through LFS.
# See .gitattributes for the LFS-tracked extensions.
tests/fixtures/large/
*.step.large
*.stp.large

# ---- IDE / editor ----
.vscode/            # keep this ignored unless you intentionally share settings
.idea/
*.user            # Qt Creator per-user project settings (*.pro.user etc.)
*.creator.user*
*.autosave
.qtc_clangd/
CMakeLists.txt.user*
.cache/             # clangd / editor caches
compile_commands.json   # generated; regenerate locally

# ---- OS cruft ----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ---- Logs / temp ----
*.log
*.tmp
*.swp
*~

# ──────────────────────────────────────────────
# NOTE: A companion .gitattributes should declare Git LFS tracking
# for large binary test models, e.g.:
#   *.step  filter=lfs diff=lfs merge=lfs -text
#   *.stp   filter=lfs diff=lfs merge=lfs -text
#   *.iges  filter=lfs diff=lfs merge=lfs -text
#   *.stl   filter=lfs diff=lfs merge=lfs -text
# Only enable these once you actually need LFS — small fixtures can stay normal.
# ──────────────────────────────────────────────
